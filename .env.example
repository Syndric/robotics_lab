# ROS Docker Environment Configuration
# Copy this file to .env and adjust values for your system

# Display settings for X11 forwarding (GUI apps like turtlesim, rqt)
# Windows (Docker Desktop): host.docker.internal:0
# Linux: :0 (or your $DISPLAY value)
# WSL2: host.docker.internal:0
DISPLAY=host.docker.internal:0

# ROS Network Configuration
ROS_MASTER_URI=http://localhost:11311
ROS_HOSTNAME=localhost

# X11 settings
LIBGL_ALWAYS_INDIRECT=1
